<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="DrangedAddons.Mac.App"
             Name="DrangedAddons"
             RequestedThemeVariant="Dark">
    <Application.Resources>
        <!-- The Windows app's palette and styles (src/App.xaml), kept the same. -->
        <SolidColorBrush x:Key="BgBrush" Color="#16181D"/>
        <SolidColorBrush x:Key="PanelBrush" Color="#1F232B"/>
        <SolidColorBrush x:Key="Panel2Brush" Color="#282D37"/>
        <SolidColorBrush x:Key="LineBrush" Color="#323844"/>
        <SolidColorBrush x:Key="TextBrush" Color="#E6E8EC"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#8B93A1"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#D4A72C"/>
        <SolidColorBrush x:Key="AccentTextBrush" Color="#1A1A1A"/>
        <SolidColorBrush x:Key="DangerBrush" Color="#E05A4F"/>
        <SolidColorBrush x:Key="RailBrush" Color="#111317"/>
        <SolidColorBrush x:Key="SelectedRowBrush" Color="#2A2410"/>
        <SolidColorBrush x:Key="ProgressFillBrush" Color="#8A6A16"/>

        <!-- Icons: the Windows app's Segoe Fluent glyphs are Windows-only, so these draw the same symbols. -->
        <StreamGeometry x:Key="PlayIcon">M8,5.14V19.14L19,12.14L8,5.14Z</StreamGeometry>
        <StreamGeometry x:Key="MoreIcon">M16,12A2,2 0 0,1 18,10A2,2 0 0,1 20,12A2,2 0 0,1 18,14A2,2 0 0,1 16,12M10,12A2,2 0 0,1 12,10A2,2 0 0,1 14,12A2,2 0 0,1 12,14A2,2 0 0,1 10,12M4,12A2,2 0 0,1 6,10A2,2 0 0,1 8,12A2,2 0 0,1 6,14A2,2 0 0,1 4,12Z</StreamGeometry>
        <StreamGeometry x:Key="RefreshIcon">M17.65,6.35C16.2,4.9 14.21,4 12,4A8,8 0 0,0 4,12A8,8 0 0,0 12,20C15.73,20 18.84,17.45 19.73,14H17.65C16.83,16.33 14.61,18 12,18A6,6 0 0,1 6,12A6,6 0 0,1 12,6C13.66,6 15.14,6.69 16.22,7.78L13,11H20V4L17.65,6.35Z</StreamGeometry>
        <StreamGeometry x:Key="FilterIcon">M14,12V19.88C14.04,20.18 13.94,20.5 13.71,20.71C13.32,21.1 12.69,21.1 12.3,20.71L10.29,18.7C10.06,18.47 9.96,18.16 10,17.87V12H9.97L4.21,4.62C3.87,4.19 3.95,3.56 4.38,3.22C4.57,3.08 4.78,3 5,3V3H19V3C19.22,3 19.43,3.08 19.62,3.22C20.05,3.56 20.13,4.19 19.79,4.62L14.03,12H14Z</StreamGeometry>
        <StreamGeometry x:Key="SearchIcon">M9.5,3A6.5,6.5 0 0,1 16,9.5C16,11.11 15.41,12.59 14.44,13.73L14.71,14H15.5L20.5,19L19,20.5L14,15.5V14.71L13.73,14.44C12.59,15.41 11.11,16 9.5,16A6.5,6.5 0 0,1 3,9.5A6.5,6.5 0 0,1 9.5,3M9.5,5C7,5 5,7 5,9.5C5,12 7,14 9.5,14C12,14 14,12 14,9.5C14,7 12,5 9.5,5Z</StreamGeometry>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme>
            <FluentTheme.Palettes>
                <ColorPaletteResources x:Key="Dark" Accent="#D4A72C" RegionColor="#1F232B" AltHigh="#16181D"
                                       ChromeMediumLow="#1F232B" ChromeLow="#1F232B"/>
            </FluentTheme.Palettes>
        </FluentTheme>

        <!-- Btn / AccentBtn / GhostBtn -->
        <Style Selector="Button.btn">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Background" Value="{StaticResource Panel2Brush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}" ClipToBounds="True">
                        <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                                          Foreground="{TemplateBinding Foreground}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.btn:pointerover /template/ Border#Chrome">
            <Setter Property="Opacity" Value="0.85"/>
        </Style>
        <Style Selector="Button.btn:disabled /template/ Border#Chrome">
            <Setter Property="Opacity" Value="0.5"/>
        </Style>
        <Style Selector="Button.accent">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource AccentTextBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <!-- Grey, not dim gold, when there's nothing to do (Update all with no updates). -->
        <Style Selector="Button.accent:disabled">
            <Setter Property="Background" Value="{StaticResource Panel2Brush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="FontWeight" Value="Normal"/>
        </Style>
        <Style Selector="Button.ghost">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <!-- The row's action button while downloading: grey with a gold edge, filled by ProgressFill. -->
        <Style Selector="Button.busy">
            <Setter Property="Background" Value="{StaticResource Panel2Brush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="FontWeight" Value="Normal"/>
        </Style>

        <!-- IconBtn: bare icon, a tile on hover -->
        <Style Selector="Button.icon">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="Chrome" Background="Transparent" CornerRadius="6">
                        <ContentPresenter Content="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.icon:pointerover /template/ Border#Chrome">
            <Setter Property="Background" Value="{StaticResource Panel2Brush}"/>
        </Style>
        <Style Selector="Button.icon:disabled /template/ Border#Chrome">
            <Setter Property="Opacity" Value="0.4"/>
        </Style>
        <Style Selector="Button.icon PathIcon">
            <Setter Property="Width" Value="15"/>
            <Setter Property="Height" Value="15"/>
        </Style>

        <!-- TabButton: muted text, gold underline when picked -->
        <Style Selector="RadioButton.tab">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,20,0"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <StackPanel Background="Transparent">
                        <ContentPresenter Content="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" Margin="0,0,0,6"/>
                        <Border Name="Underline" Height="2" CornerRadius="1" Background="{StaticResource AccentBrush}" Opacity="0"/>
                    </StackPanel>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="RadioButton.tab:checked">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        </Style>
        <Style Selector="RadioButton.tab:checked /template/ Border#Underline">
            <Setter Property="Opacity" Value="1"/>
        </Style>
        <Style Selector="RadioButton.tab:pointerover">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        </Style>

        <!-- SearchBox -->
        <Style Selector="TextBox.search">
            <Setter Property="Background" Value="{StaticResource Panel2Brush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="CaretBrush" Value="{StaticResource TextBrush}"/>
            <Setter Property="SelectionBrush" Value="{StaticResource AccentBrush}"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="8,0"/>
        </Style>
        <Style Selector="TextBox.search:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="{StaticResource Panel2Brush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource MutedBrush}"/>
        </Style>
        <Style Selector="TextBox.search:focus /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="{StaticResource Panel2Brush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style Selector="TextBox.search /template/ TextBlock#PART_Watermark">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
        </Style>
        <Style Selector="TextBox.search:focus /template/ TextBlock#PART_Watermark">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
        </Style>

        <!-- DarkCombo -->
        <Style Selector="ComboBox.dark">
            <Setter Property="Background" Value="{StaticResource Panel2Brush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="CornerRadius" Value="6"/>
        </Style>
        <Style Selector="ComboBox.dark:pointerover /template/ Border#Background">
            <Setter Property="Background" Value="{StaticResource Panel2Brush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource MutedBrush}"/>
        </Style>

        <!-- AddonRow: compact clickable row; gold edge on hover; gold tint when ticked -->
        <Style Selector="Border.row">
            <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Border.row:pointerover">
            <Setter Property="Background" Value="{StaticResource Panel2Brush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
        </Style>
        <Style Selector="Border.row.selected">
            <Setter Property="Background" Value="{StaticResource SelectedRowBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
        </Style>

        <!-- BetaBubble -->
        <Style Selector="Border.beta">
            <Setter Property="Background" Value="#7E5BD0"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="6,0,6,1"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- RailButton: game in the side bar; gold bar when it's the one shown -->
        <Style Selector="Button.rail">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="64"/>
            <Setter Property="Height" Value="58"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Grid Background="Transparent">
                        <Border Name="Bar" Width="3" HorizontalAlignment="Left" Margin="0,12" CornerRadius="0,2,2,0"
                                Background="{StaticResource AccentBrush}" Opacity="0"/>
                        <Border Name="Tile" Width="46" Height="46" CornerRadius="10" Background="Transparent">
                            <ContentPresenter Content="{TemplateBinding Content}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.rail:pointerover /template/ Border#Tile">
            <Setter Property="Background" Value="{StaticResource Panel2Brush}"/>
        </Style>
        <Style Selector="Button.rail.selected /template/ Border#Bar">
            <Setter Property="Opacity" Value="1"/>
        </Style>
        <Style Selector="Button.rail.selected /template/ Border#Tile">
            <Setter Property="Background" Value="{StaticResource Panel2Brush}"/>
        </Style>
    </Application.Styles>
</Application>
