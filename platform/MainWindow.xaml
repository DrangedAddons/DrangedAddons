<Window x:Class="DrangedPlatform.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DrangedAddons Platform" Width="1120" Height="820" MinWidth="760" MinHeight="520"
        WindowStartupLocation="CenterScreen" Icon="platform.ico"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI" FontSize="13">
    <DockPanel>
        <!-- Header: what this is, and whether each live part of the platform is answering. -->
        <Border DockPanel.Dock="Top" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}"
                BorderThickness="0,0,0,1" Padding="28,18">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="UpdatedText" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"
                               Margin="0,0,12,0"/>
                    <Button x:Name="RefreshButton" Content="Refresh" Style="{StaticResource Btn}" Click="Refresh_Click"/>
                </StackPanel>
                <Image Source="logo.png" Width="40" Height="40" Margin="0,0,14,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="DrangedAddons Platform" FontSize="20" FontWeight="SemiBold"/>
                    <TextBlock x:Name="SubtitleText" Foreground="{StaticResource MutedBrush}"
                               Text="Accounts, friends and lobbies that games join as profiles, each with its own connectivity type."/>
                </StackPanel>
            </DockPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="Root" Margin="28,22,28,28"/>
        </ScrollViewer>
    </DockPanel>
</Window>
