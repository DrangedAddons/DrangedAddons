<Window x:Class="DrangedAddons.AccountWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Account" Width="440" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI" FontSize="13">
    <StackPanel Margin="24,20">
        <TextBlock Text="Account" FontSize="20" FontWeight="SemiBold"/>

        <!-- Picture: a circle with the picture, or the name's initials. -->
        <DockPanel Margin="0,18,0,0">
            <Grid Width="72" Height="72" DockPanel.Dock="Left">
                <Ellipse Fill="{StaticResource Panel2Brush}" Stroke="{StaticResource LineBrush}" StrokeThickness="1"/>
                <TextBlock x:Name="InitialsText" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <Ellipse x:Name="PictureCircle" Visibility="Collapsed">
                    <Ellipse.Fill>
                        <ImageBrush x:Name="PictureBrush" Stretch="UniformToFill"/>
                    </Ellipse.Fill>
                </Ellipse>
            </Grid>
            <StackPanel VerticalAlignment="Center" Margin="16,0,0,0">
                <StackPanel Orientation="Horizontal">
                    <Button Content="Choose picture…" Style="{StaticResource Btn}" Click="ChoosePicture_Click"/>
                    <Button x:Name="RemovePictureButton" Content="Remove" Style="{StaticResource GhostBtn}" Margin="8,0,0,0"
                            Click="RemovePicture_Click"/>
                </StackPanel>
                <TextBlock x:Name="PictureError" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" Margin="0,6,0,0"
                           Visibility="Collapsed"/>
            </StackPanel>
        </DockPanel>

        <TextBlock Text="Name" FontWeight="SemiBold" Margin="0,18,0,6"/>
        <Border Background="{StaticResource Panel2Brush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                CornerRadius="6" Padding="8,0" Height="32">
            <Grid>
                <TextBlock x:Name="NamePlaceholder" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"
                           IsHitTestVisible="False" Margin="2,0,0,0"/>
                <TextBox x:Name="NameBox" Background="Transparent" BorderThickness="0" VerticalContentAlignment="Center"
                         Foreground="{StaticResource TextBrush}" CaretBrush="{StaticResource TextBrush}"
                         MaxLength="24" TextChanged="NameBox_TextChanged"/>
            </Grid>
        </Border>

        <TextBlock Text="Status" FontWeight="SemiBold" Margin="0,18,0,6"/>
        <ComboBox x:Name="StatusList" Style="{StaticResource DarkCombo}" Height="34" HorizontalAlignment="Left" Width="200">
            <ComboBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="10" Height="10" Fill="{Binding Brush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock Text="{Binding Label}" VerticalAlignment="Center"/>
                    </StackPanel>
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>
        <TextBlock Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,0" FontSize="12"
                   Text="Shows In game while you play, and Away after 10 minutes idle."/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
            <Button Content="Cancel" Style="{StaticResource Btn}" MinWidth="90" IsCancel="True" Margin="0,0,8,0"/>
            <Button Content="Save" Style="{StaticResource AccentBtn}" MinWidth="90" IsDefault="True" Click="Save_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
