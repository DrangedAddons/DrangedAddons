<Window x:Class="DrangedAddons.AddGameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add a game" Width="760" Height="560" MinWidth="460" MinHeight="360"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI" FontSize="13">
    <Grid Margin="24,20">
        <!-- Step 1: pick a game. -->
        <DockPanel x:Name="PickPanel">
            <StackPanel DockPanel.Dock="Top">
                <TextBlock Text="Add a game" FontSize="20" FontWeight="SemiBold"/>
                <TextBlock Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,6,0,14"
                           Text="Games DrangedAddons supports. Adding one puts it in the side bar, where you can switch to it; its addons show there as they're published."/>
                <TextBox x:Name="SearchBox" Style="{StaticResource SearchBox}" Height="36" FontSize="14" Margin="0,0,0,16"
                         Tag="Search games…" TextChanged="Search_TextChanged"/>
            </StackPanel>
            <Button DockPanel.Dock="Bottom" Content="Close" Style="{StaticResource Btn}" MinWidth="90" HorizontalAlignment="Right"
                    Margin="0,16,0,0" IsCancel="True"/>

            <Grid>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="GameList" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <!-- One tile per game; the full description and where it's installed are in the tooltip. -->
                                <Border Width="214" Height="250" Padding="14" Margin="0,0,12,12" CornerRadius="8" BorderThickness="1"
                                        Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}">
                                    <Border.ToolTip>
                                        <StackPanel MaxWidth="320">
                                            <TextBlock Text="{Binding Description}" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding LocationText}" TextWrapping="Wrap" Margin="0,6,0,0" Opacity="0.75"/>
                                        </StackPanel>
                                    </Border.ToolTip>
                                    <DockPanel>
                                        <Button DockPanel.Dock="Bottom" Content="{Binding ButtonText}" Style="{StaticResource AccentBtn}"
                                                IsEnabled="{Binding CanAdd}" Click="Add_Click"/>
                                        <StackPanel>
                                            <Grid Width="72" Height="72" HorizontalAlignment="Center">
                                                <Border CornerRadius="12" Background="{StaticResource Panel2Brush}" BorderBrush="{StaticResource LineBrush}"
                                                        BorderThickness="1" Visibility="{Binding NoIcon, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="{Binding Initials}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <Image Source="{Binding Icon}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"
                                                       Visibility="{Binding HasIcon, Converter={StaticResource BoolToVis}}"/>
                                            </Grid>
                                            <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" Margin="0,10,0,0"/>
                                            <Border CornerRadius="9" Padding="8,1" Margin="0,6,0,0" HorizontalAlignment="Center"
                                                    Background="{Binding AddonsBrush}">
                                                <TextBlock Text="{Binding AddonsText}" Foreground="#111111" FontSize="11" FontWeight="SemiBold"/>
                                            </Border>
                                            <TextBlock Text="{Binding Description}" Foreground="{StaticResource MutedBrush}" FontSize="12"
                                                       TextWrapping="Wrap" TextTrimming="CharacterEllipsis" TextAlignment="Center"
                                                       MaxHeight="34" Margin="0,8,0,0"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <TextBlock x:Name="NoMatchText" Text="No games match your search." Foreground="{StaticResource MutedBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
            </Grid>
        </DockPanel>

        <!-- Step 2: where it's installed. -->
        <DockPanel x:Name="FolderPanel" Visibility="Collapsed">
            <DockPanel DockPanel.Dock="Bottom" Margin="0,16,0,0">
                <Button Content="Back" Style="{StaticResource Btn}" MinWidth="90" Click="Back_Click"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancel" Style="{StaticResource Btn}" MinWidth="90" Margin="0,0,8,0" IsCancel="True"/>
                    <Button x:Name="ConfirmButton" Content="Add game" Style="{StaticResource AccentBtn}" MinWidth="110"
                            IsDefault="True" Click="Confirm_Click"/>
                </StackPanel>
            </DockPanel>
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Grid Width="56" Height="56" Margin="0,0,14,0">
                        <Border x:Name="ChosenInitialsTile" CornerRadius="10" Background="{StaticResource Panel2Brush}"
                                BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
                            <TextBlock x:Name="ChosenInitials" FontSize="18" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <Image x:Name="ChosenIcon" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Grid>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="ChosenName" FontSize="20" FontWeight="SemiBold"/>
                        <TextBlock Text="Where is it installed?" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <TextBlock Text="Game folder" FontWeight="SemiBold" Margin="0,24,0,6"/>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Browse…" Style="{StaticResource Btn}" Margin="8,0,0,0" Click="Browse_Click"/>
                    <Border Background="{StaticResource Panel2Brush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                            CornerRadius="6" Padding="8,0" Height="34">
                        <TextBox x:Name="FolderBox" Background="Transparent" BorderThickness="0" VerticalContentAlignment="Center"
                                 Foreground="{StaticResource TextBrush}" CaretBrush="{StaticResource TextBrush}"
                                 TextChanged="FolderBox_TextChanged"/>
                    </Border>
                </DockPanel>
                <TextBlock x:Name="FolderStatus" TextWrapping="Wrap" Margin="0,8,0,0"/>
                <TextBlock x:Name="FolderNote" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" FontSize="12" Margin="0,8,0,0"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
