<Window x:Class="DrangedAddons.AddGameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add a game" Width="620" SizeToContent="Height" MaxHeight="720" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI" FontSize="13">
    <DockPanel Margin="24,20">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="Add a game" FontSize="20" FontWeight="SemiBold"/>
            <TextBlock Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,6,0,14"
                       Text="Games with DrangedAddons addons. Adding one puts it in the side bar, where you can switch to it."/>
        </StackPanel>
        <Button DockPanel.Dock="Bottom" Content="Close" Style="{StaticResource Btn}" MinWidth="90" HorizontalAlignment="Right"
                Margin="0,16,0,0" IsCancel="True"/>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="GameList" Focusable="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="14,12" Margin="0,0,0,8" CornerRadius="8" BorderThickness="1"
                                Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}"
                                Opacity="{Binding CardOpacity}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid Width="56" Height="56" Margin="0,0,14,0" VerticalAlignment="Top">
                                    <Border CornerRadius="10" Background="{StaticResource Panel2Brush}" BorderBrush="{StaticResource LineBrush}"
                                            BorderThickness="1" Visibility="{Binding NoIcon, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="{Binding Initials}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <Image Source="{Binding Icon}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"
                                           Visibility="{Binding HasIcon, Converter={StaticResource BoolToVis}}"/>
                                </Grid>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold"/>
                                        <Border CornerRadius="9" Padding="8,1" Margin="10,0,0,0" VerticalAlignment="Center"
                                                Background="{Binding AddonsBrush}">
                                            <TextBlock Text="{Binding AddonsText}" Foreground="#111111" FontSize="11" FontWeight="SemiBold"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                    <TextBlock Text="{Binding LocationText}" Foreground="{StaticResource MutedBrush}" FontSize="12"
                                               TextWrapping="Wrap" Margin="0,4,0,0"/>
                                </StackPanel>
                                <Button Grid.Column="2" Content="{Binding ButtonText}" Style="{StaticResource AccentBtn}" MinWidth="96"
                                        Margin="14,0,0,0" VerticalAlignment="Center" IsEnabled="{Binding CanAdd}" Click="Add_Click"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</Window>
