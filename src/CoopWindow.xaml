<Window x:Class="DrangedAddons.CoopWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Azeroth Survivors" Width="560" SizeToContent="Height" ResizeMode="CanMinimize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI" FontSize="13">
    <Window.Resources>
        <SolidColorBrush x:Key="ReadyBrush" Color="#6CC07A"/>
        <Style x:Key="Field" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Panel2Brush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="Height" Value="32"/>
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16,12"/>
        </Style>
        <Style x:Key="Heading" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
    </Window.Resources>

    <StackPanel Margin="28,22">
        <TextBlock x:Name="TitleText" Text="Azeroth Survivors" FontSize="24" FontWeight="SemiBold"/>

        <!-- Invites from members: shown on every screen until answered. -->
        <StackPanel x:Name="InviteList" Margin="0,14,0,0"/>

        <!-- Start: host or join. -->
        <!-- Start: play alone, or host / join co-op. -->
        <StackPanel x:Name="StartPanel" Margin="0,6,0,0">
            <Button x:Name="SoloPlayButton" Style="{StaticResource AccentBtn}" Height="72" Click="Play_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xF5B0;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="18"
                               VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <TextBlock Text="Play" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <UniformGrid Columns="2" Margin="0,12,0,0">
                <Button x:Name="HostButton" Style="{StaticResource Btn}" Height="64" Margin="0,0,6,0" Click="Host_Click">
                    <TextBlock Text="Host a lobby" FontSize="15" FontWeight="SemiBold"/>
                </Button>
                <Button x:Name="JoinButton" Style="{StaticResource Btn}" Height="64" Margin="6,0,0,0" Click="Join_Click">
                    <TextBlock Text="Join a lobby" FontSize="15" FontWeight="SemiBold"/>
                </Button>
            </UniformGrid>
        </StackPanel>

        <!-- Join: a code, or a member's open lobby. -->
        <StackPanel x:Name="JoinPanel" Visibility="Collapsed" Margin="0,6,0,0">
            <DockPanel>
                <Button x:Name="JoinCodeButton" DockPanel.Dock="Right" Content="Join" Style="{StaticResource AccentBtn}"
                        MinWidth="90" Margin="8,0,0,0" Click="JoinCode_Click"/>
                <Border Style="{StaticResource Field}" Height="38">
                    <Grid>
                        <TextBlock x:Name="CodeHint" Text="Lobby code" Foreground="{StaticResource MutedBrush}"
                                   VerticalAlignment="Center" IsHitTestVisible="False"/>
                        <TextBox x:Name="CodeBox" Background="Transparent" BorderThickness="0" VerticalContentAlignment="Center"
                                 Foreground="{StaticResource TextBrush}" CaretBrush="{StaticResource TextBrush}"
                                 FontFamily="Consolas" FontSize="18" CharacterCasing="Upper" MaxLength="7"
                                 TextChanged="CodeBox_TextChanged"/>
                    </Grid>
                </Border>
            </DockPanel>
            <DockPanel x:Name="JoinPasswordRow" Margin="0,8,0,0" Visibility="Collapsed">
                <TextBlock Text="Password" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <Border Style="{StaticResource Field}">
                    <PasswordBox x:Name="JoinPasswordBox" Background="Transparent" BorderThickness="0"
                                 VerticalContentAlignment="Center" Foreground="{StaticResource TextBrush}"
                                 CaretBrush="{StaticResource TextBrush}" KeyDown="JoinPassword_KeyDown"/>
                </Border>
            </DockPanel>
            <TextBlock Text="Open lobbies" Style="{StaticResource Heading}" Margin="0,18,0,0"/>
            <Border Style="{StaticResource Card}" Margin="0,8,0,0" Padding="12,8">
                <ScrollViewer MaxHeight="260" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="LobbyList"/>
                </ScrollViewer>
            </Border>
        </StackPanel>

        <!-- The lobby (hosting or joined). -->
        <Grid x:Name="LobbyPanel" Visibility="Collapsed" Margin="0,6,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="340"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header: the code, and the lobby's settings (host) or state (joined). -->
            <Grid Grid.ColumnSpan="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="210"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}" Margin="0,0,12,0">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="Lobby code" Style="{StaticResource Caption}" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="CodeText" FontFamily="Consolas" FontSize="30" FontWeight="SemiBold"
                                   Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" Margin="0,2,0,4"/>
                        <Button x:Name="CopyButton" Content="Copy" Style="{StaticResource GhostBtn}" Padding="14,3"
                                HorizontalAlignment="Center" Click="Copy_Click"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource Card}">
                    <Grid VerticalAlignment="Center">
                        <!-- Host: who can get in. -->
                        <StackPanel x:Name="HostSettings">
                            <TextBlock Text="Who can join" Style="{StaticResource Caption}"/>
                            <DockPanel Margin="0,8,0,0">
                                <CheckBox x:Name="LockedCheck" Content="Locked" VerticalAlignment="Center" Margin="0,0,20,0"
                                          Click="Settings_Changed" ToolTip="Only members you invite can join"/>
                                <TextBlock Text="Password" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <Border Style="{StaticResource Field}">
                                    <Grid>
                                        <TextBlock x:Name="PasswordHint" Text="None" Foreground="{StaticResource MutedBrush}"
                                                   VerticalAlignment="Center" IsHitTestVisible="False"/>
                                        <PasswordBox x:Name="HostPasswordBox" Background="Transparent" BorderThickness="0"
                                                     VerticalContentAlignment="Center" Foreground="{StaticResource TextBrush}"
                                                     CaretBrush="{StaticResource TextBrush}" PasswordChanged="HostPassword_Changed"/>
                                    </Grid>
                                </Border>
                            </DockPanel>
                            <TextBlock x:Name="AccessText" Style="{StaticResource Caption}" Margin="0,8,0,0"/>
                        </StackPanel>
                        <!-- Joined: whose lobby, and whether the game is on. -->
                        <StackPanel x:Name="JoinedInfo" Visibility="Collapsed">
                            <TextBlock Text="Host" Style="{StaticResource Caption}"/>
                            <TextBlock x:Name="HostNameText" FontSize="18" FontWeight="SemiBold" Margin="0,2,0,0"/>
                            <TextBlock x:Name="GameStateText" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- Slots: five, filled in join order; the host's actions sit on each one. -->
            <StackPanel Grid.Row="1" Margin="0,18,0,0">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBlock Text="Players" Style="{StaticResource Heading}"/>
                    <StackPanel x:Name="SlotDots" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,1,0,0"/>
                    <TextBlock x:Name="SlotCount" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="8,1,0,0"/>
                </StackPanel>
                <StackPanel x:Name="SlotList"/>
            </StackPanel>

            <!-- Lobby chat: what happens in the lobby (joins, invites, settings, start) and what players say. -->
            <DockPanel Grid.Row="1" Grid.Column="1" Margin="16,18,0,8">
                <TextBlock DockPanel.Dock="Top" Text="Lobby chat" Style="{StaticResource Heading}" Margin="0,0,0,10"/>
                <Border Style="{StaticResource Card}" Padding="0">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Bottom" Margin="10">
                            <Button x:Name="SendButton" DockPanel.Dock="Right" Content="Send" Style="{StaticResource Btn}"
                                    Margin="8,0,0,0" Click="Send_Click"/>
                            <Border Style="{StaticResource Field}">
                                <Grid>
                                    <TextBlock x:Name="ChatHint" Text="Say something…" Foreground="{StaticResource MutedBrush}"
                                               VerticalAlignment="Center" IsHitTestVisible="False"/>
                                    <TextBox x:Name="ChatBox" Background="Transparent" BorderThickness="0" VerticalContentAlignment="Center"
                                             Foreground="{StaticResource TextBrush}" CaretBrush="{StaticResource TextBrush}"
                                             MaxLength="300" TextChanged="ChatBox_TextChanged" KeyDown="ChatBox_KeyDown"/>
                                </Grid>
                            </Border>
                        </DockPanel>
                        <Border DockPanel.Dock="Bottom" Height="1" Background="{StaticResource LineBrush}"/>
                        <ScrollViewer x:Name="LogScroll" VerticalScrollBarVisibility="Auto" Padding="14,10">
                            <StackPanel x:Name="LogList"/>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </DockPanel>

            <!-- Invite: opens from an open slot's Invite button. -->
            <Popup x:Name="InvitePopup" StaysOpen="False" Placement="Bottom" AllowsTransparency="True" PopupAnimation="Fade"
                   VerticalOffset="6">
                <Border Width="320" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource AccentBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="12">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,10">
                            <TextBlock Text="Invite members" Style="{StaticResource Heading}"/>
                        </DockPanel>
                        <Border Style="{StaticResource Field}">
                            <Grid>
                                <TextBlock x:Name="SearchHint" Text="Search" Foreground="{StaticResource MutedBrush}"
                                           VerticalAlignment="Center" IsHitTestVisible="False"/>
                                <TextBox x:Name="SearchBox" Background="Transparent" BorderThickness="0" VerticalContentAlignment="Center"
                                         Foreground="{StaticResource TextBrush}" CaretBrush="{StaticResource TextBrush}"
                                         TextChanged="SearchBox_TextChanged"/>
                            </Grid>
                        </Border>
                        <ScrollViewer MaxHeight="260" VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
                            <StackPanel x:Name="OnlineList"/>
                        </ScrollViewer>
                    </StackPanel>
                </Border>
            </Popup>
        </Grid>

        <!-- Errors and what's happening; short. -->
        <StackPanel x:Name="StatusList" Margin="0,14,0,0"/>

        <DockPanel Margin="0,18,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BackButton" Content="Close" Style="{StaticResource Btn}" MinWidth="110" Height="38" Click="Back_Click"/>
                <Button x:Name="StartButton" Content="Start game" Style="{StaticResource AccentBtn}" MinWidth="140" Height="38"
                        Margin="10,0,0,0" Visibility="Collapsed" Click="StartGame_Click"/>
            </StackPanel>
        </DockPanel>
    </StackPanel>
</Window>
