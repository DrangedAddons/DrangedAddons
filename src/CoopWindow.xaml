<Window x:Class="DrangedAddons.CoopWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Direct co-op" Width="560" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI" FontSize="13">
    <StackPanel Margin="24,20">
        <TextBlock Text="Direct co-op" FontSize="20" FontWeight="SemiBold"/>
        <TextBlock Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,6,0,0"
                   Text="Starts Azeroth Survivors connected straight to the host, instead of through the game's co-op relay overseas. Everyone in the party starts the game from here: the host first, then the others. Experimental: it uses switches the game doesn't document."/>

        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
            <RadioButton x:Name="HostTab" GroupName="CoopMode" Style="{StaticResource TabButton}" Content="Host"
                         IsChecked="True" Checked="Mode_Checked"/>
            <RadioButton x:Name="JoinTab" GroupName="CoopMode" Style="{StaticResource TabButton}" Content="Join"
                         Checked="Mode_Checked"/>
        </StackPanel>

        <!-- Host: the port to listen on, and this PC's addresses to send the others. -->
        <StackPanel x:Name="HostPanel" Margin="0,12,0,0">
            <TextBlock Text="Port" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <Border Background="{StaticResource Panel2Brush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                    CornerRadius="6" Padding="8,0" Height="32" Width="120" HorizontalAlignment="Left">
                <TextBox x:Name="PortBox" Background="Transparent" BorderThickness="0" VerticalContentAlignment="Center"
                         Foreground="{StaticResource TextBrush}" CaretBrush="{StaticResource TextBrush}"
                         TextChanged="Input_Changed"/>
            </Border>
            <TextBlock Text="Send the others one of these" FontWeight="SemiBold" Margin="0,14,0,6"/>
            <Border Padding="12,10" CornerRadius="6" Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
                <StackPanel x:Name="AddressList"/>
            </Border>
            <TextBlock Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,0" FontSize="12"
                       Text="Easiest: everyone installs Tailscale and signs in to the same network; then the 100.x address works with no router changes. Otherwise forward this TCP port on your router to this PC and send your public IP."/>
        </StackPanel>

        <!-- Join: the host's address. -->
        <StackPanel x:Name="JoinPanel" Margin="0,12,0,0" Visibility="Collapsed">
            <TextBlock Text="Host's address (ip:port)" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <Border Background="{StaticResource Panel2Brush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                    CornerRadius="6" Padding="8,0" Height="32">
                <TextBox x:Name="AddressBox" Background="Transparent" BorderThickness="0" VerticalContentAlignment="Center"
                         Foreground="{StaticResource TextBrush}" CaretBrush="{StaticResource TextBrush}"
                         TextChanged="Input_Changed"/>
            </Border>
        </StackPanel>

        <TextBlock Text="Password (optional, same for everyone)" FontWeight="SemiBold" Margin="0,14,0,6"/>
        <Border Background="{StaticResource Panel2Brush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                CornerRadius="6" Padding="8,0" Height="32">
            <PasswordBox x:Name="PasswordBox" Background="Transparent" BorderThickness="0" VerticalContentAlignment="Center"
                         Foreground="{StaticResource TextBrush}" CaretBrush="{StaticResource TextBrush}"/>
        </Border>

        <TextBlock x:Name="MessageText" TextWrapping="Wrap" Margin="0,10,0,0" Foreground="{StaticResource DangerBrush}"
                   Visibility="Collapsed"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Close" Style="{StaticResource Btn}" MinWidth="90" IsCancel="True" Margin="0,0,8,0"
                    Click="Close_Click"/>
            <Button x:Name="StartButton" Content="Host and start" Style="{StaticResource AccentBtn}" MinWidth="130"
                    IsDefault="True" Click="Start_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
