<Window x:Class="DrangedAddons.CoopWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Direct co-op" Width="500" SizeToContent="Height" ResizeMode="CanMinimize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI" FontSize="13">
    <Window.Resources>
        <Style x:Key="Field" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Panel2Brush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="Height" Value="32"/>
        </Style>
        <Style x:Key="ListBox" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Margin" Value="0,6,0,0"/>
        </Style>
        <Style x:Key="Heading" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <StackPanel Margin="24,20">
        <TextBlock x:Name="TitleText" Text="Direct co-op" FontSize="20" FontWeight="SemiBold"/>

        <!-- Invites from members: shown on every screen until answered. -->
        <StackPanel x:Name="InviteList" Margin="0,12,0,0"/>

        <!-- Start: host or join. -->
        <UniformGrid x:Name="StartPanel" Columns="2" Margin="0,8,0,0">
            <Button x:Name="HostButton" Style="{StaticResource AccentBtn}" Height="64" Margin="0,0,6,0" Click="Host_Click">
                <TextBlock Text="Host a lobby" FontSize="15" FontWeight="SemiBold"/>
            </Button>
            <Button x:Name="JoinButton" Style="{StaticResource Btn}" Height="64" Margin="6,0,0,0" Click="Join_Click">
                <TextBlock Text="Join a lobby" FontSize="15" FontWeight="SemiBold"/>
            </Button>
        </UniformGrid>

        <!-- Host: the lobby's code and settings. -->
        <StackPanel x:Name="HostPanel" Visibility="Collapsed" Margin="0,8,0,0">
            <DockPanel>
                <Button x:Name="CopyButton" DockPanel.Dock="Right" Content="Copy" Style="{StaticResource GhostBtn}" Click="Copy_Click"/>
                <TextBlock Text="Code" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBlock x:Name="CodeText" FontFamily="Consolas" FontSize="22" FontWeight="SemiBold"
                           Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
            </DockPanel>
            <DockPanel Margin="0,12,0,0">
                <CheckBox x:Name="LockedCheck" Content="Locked" VerticalAlignment="Center" Margin="0,0,16,0"
                          Click="Settings_Changed" ToolTip="Nobody new can join, except members you invite"/>
                <TextBlock Text="Password" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <Border Style="{StaticResource Field}">
                    <Grid>
                        <TextBlock x:Name="PasswordHint" Text="None" Foreground="{StaticResource MutedBrush}"
                                   VerticalAlignment="Center" IsHitTestVisible="False"/>
                        <PasswordBox x:Name="HostPasswordBox" Background="Transparent" BorderThickness="0"
                                     VerticalContentAlignment="Center" Foreground="{StaticResource TextBrush}"
                                     CaretBrush="{StaticResource TextBrush}" PasswordChanged="HostPassword_Changed"/>
                    </Grid>
                </Border>
            </DockPanel>
        </StackPanel>

        <!-- Join: a code, or a member's open lobby. -->
        <StackPanel x:Name="JoinPanel" Visibility="Collapsed" Margin="0,8,0,0">
            <DockPanel>
                <Button x:Name="JoinCodeButton" DockPanel.Dock="Right" Content="Join" Style="{StaticResource AccentBtn}"
                        MinWidth="80" Margin="8,0,0,0" Click="JoinCode_Click"/>
                <Border Style="{StaticResource Field}" Height="36">
                    <Grid>
                        <TextBlock x:Name="CodeHint" Text="Lobby code" Foreground="{StaticResource MutedBrush}"
                                   VerticalAlignment="Center" IsHitTestVisible="False"/>
                        <TextBox x:Name="CodeBox" Background="Transparent" BorderThickness="0" VerticalContentAlignment="Center"
                                 Foreground="{StaticResource TextBrush}" CaretBrush="{StaticResource TextBrush}"
                                 FontFamily="Consolas" FontSize="18" CharacterCasing="Upper" MaxLength="7"
                                 TextChanged="CodeBox_TextChanged"/>
                    </Grid>
                </Border>
            </DockPanel>
            <DockPanel x:Name="JoinPasswordRow" Margin="0,8,0,0" Visibility="Collapsed">
                <TextBlock Text="Password" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <Border Style="{StaticResource Field}">
                    <PasswordBox x:Name="JoinPasswordBox" Background="Transparent" BorderThickness="0"
                                 VerticalContentAlignment="Center" Foreground="{StaticResource TextBrush}"
                                 CaretBrush="{StaticResource TextBrush}" KeyDown="JoinPassword_KeyDown"/>
                </Border>
            </DockPanel>
            <TextBlock x:Name="OpenHeader" Text="Open lobbies" Style="{StaticResource Heading}" Margin="0,16,0,0"/>
            <Border Style="{StaticResource ListBox}">
                <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="LobbyList" Margin="12,8"/>
                </ScrollViewer>
            </Border>
        </StackPanel>

        <!-- In a lobby (hosting or joined): who's in it. -->
        <StackPanel x:Name="MembersPanel" Visibility="Collapsed" Margin="0,16,0,0">
            <TextBlock x:Name="MembersHeader" Text="In the lobby" Style="{StaticResource Heading}"/>
            <Border Style="{StaticResource ListBox}">
                <StackPanel x:Name="MemberList" Margin="12,8"/>
            </Border>
        </StackPanel>

        <!-- Host: members online to invite. -->
        <StackPanel x:Name="InvitePanel" Visibility="Collapsed" Margin="0,16,0,0">
            <DockPanel>
                <Border DockPanel.Dock="Right" Style="{StaticResource Field}" Height="28" Width="160">
                    <Grid>
                        <TextBlock x:Name="SearchHint" Text="Search" Foreground="{StaticResource MutedBrush}"
                                   VerticalAlignment="Center" IsHitTestVisible="False"/>
                        <TextBox x:Name="SearchBox" Background="Transparent" BorderThickness="0" VerticalContentAlignment="Center"
                                 Foreground="{StaticResource TextBrush}" CaretBrush="{StaticResource TextBrush}"
                                 TextChanged="SearchBox_TextChanged"/>
                    </Grid>
                </Border>
                <TextBlock x:Name="OnlineHeader" Text="Invite members" Style="{StaticResource Heading}"/>
            </DockPanel>
            <Border Style="{StaticResource ListBox}">
                <ScrollViewer MaxHeight="200" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="OnlineList" Margin="12,8"/>
                </ScrollViewer>
            </Border>
        </StackPanel>

        <!-- Errors and what's happening; short. -->
        <StackPanel x:Name="StatusList" Margin="0,12,0,0"/>

        <DockPanel Margin="0,16,0,0">
            <CheckBox x:Name="OnlineCheck" Content="Show me online" VerticalAlignment="Center"
                      Foreground="{StaticResource MutedBrush}" Click="OnlineCheck_Click"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BackButton" Content="Close" Style="{StaticResource Btn}" MinWidth="90" Click="Back_Click"/>
                <Button x:Name="StartButton" Content="Start game" Style="{StaticResource AccentBtn}" MinWidth="110"
                        Margin="8,0,0,0" Visibility="Collapsed" Click="StartGame_Click"/>
            </StackPanel>
        </DockPanel>
    </StackPanel>
</Window>
