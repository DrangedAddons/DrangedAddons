<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- Only for the tray icon (NotifyIcon); WinForms names are used qualified so they don't clash with WPF. -->
    <UseWindowsForms>true</UseWindowsForms>
    <Version>0.28.2</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Regenerate with tools/make_icon.py -->
    <ApplicationIcon>app.ico</ApplicationIcon>
    <Product>DrangedAddons</Product>
    <AssemblyTitle>DrangedAddons</AssemblyTitle>
  </PropertyGroup>

  <ItemGroup>
    <!-- Header logo; regenerate with tools/make_icon.py alongside app.ico -->
    <Resource Include="logo.png" />
    <Resource Include="logos\*.png" />
    <Resource Include="gameicons\*.png" />
    <Resource Include="versionicons\*.png" />
    <!-- Tray icon -->
    <Resource Include="app.ico" />
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <!-- dotnet publish -c Release  →  one self-contained DrangedAddons.exe that friends can run without installing .NET -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <!--
    The runtime marks msquic.dll (QUIC, for Direct co-op) DropFromSingleFile, so a single-file exe has no QUIC.
    Embed it instead; CoopTunnel writes it out and hands it to .NET on first use. Only builds with a runtime
    identifier (Release) resolve runtime-pack files; Debug runs on the shared runtime, which has its own.
  -->
  <Target Name="EmbedMsQuic" AfterTargets="ResolveRuntimePackAssets">
    <ItemGroup>
      <EmbeddedResource Include="@(RuntimePackAsset)" Condition="'%(Filename)%(Extension)' == 'msquic.dll'" LogicalName="msquic.dll" />
    </ItemGroup>
  </Target>

</Project>
