<Window x:Class="DrangedAddons.FriendsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Friends" Width="420" Height="640" MinWidth="360" MinHeight="400"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI" FontSize="13">
    <!-- Laid out like the in-game overlay's Friends window (overlay/src/ui.cpp), with the same sections and buttons. -->
    <DockPanel Margin="20,18,20,18">
        <!-- You, at the top. -->
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <ContentControl x:Name="YouPicture" DockPanel.Dock="Left"/>
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="YouName" FontSize="15" FontWeight="SemiBold"/>
                <TextBlock x:Name="YouStatus" FontSize="12" Margin="0,1,0,0"/>
            </StackPanel>
        </DockPanel>
        <Border DockPanel.Dock="Top" Height="1" Background="{StaticResource LineBrush}" Margin="0,0,0,12"/>

        <!-- Filters friends; from two letters, also finds members (anyone who has used the manager) to add. -->
        <Border DockPanel.Dock="Top" Background="{StaticResource Panel2Brush}"
                BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="6" Padding="8,0" Height="34">
            <Grid>
                <TextBlock x:Name="SearchHint" Text="Search friends, or find members to add" Foreground="{StaticResource MutedBrush}"
                           VerticalAlignment="Center" IsHitTestVisible="False" Margin="2,0,0,0"/>
                <TextBox x:Name="SearchBox" Background="Transparent" BorderThickness="0" VerticalContentAlignment="Center"
                         Foreground="{StaticResource TextBrush}" CaretBrush="{StaticResource TextBrush}" MaxLength="24"
                         TextChanged="SearchBox_TextChanged"/>
            </Grid>
        </Border>

        <TextBlock x:Name="StateText" DockPanel.Dock="Top" Foreground="{StaticResource MutedBrush}" Margin="0,12,0,0"
                   TextWrapping="Wrap" Visibility="Collapsed"/>

        <Button DockPanel.Dock="Bottom" Content="Close" Style="{StaticResource Btn}" MinWidth="90" HorizontalAlignment="Right"
                Margin="0,14,0,0" IsCancel="True" Click="Close_Click"/>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,4,0,0">
            <StackPanel x:Name="Lists"/>
        </ScrollViewer>
    </DockPanel>
</Window>
