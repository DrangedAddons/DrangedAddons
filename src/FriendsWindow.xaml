<Window x:Class="DrangedAddons.FriendsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Friends" Width="460" Height="600" MinWidth="380" MinHeight="360"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI" FontSize="13">
    <DockPanel Margin="24,20,24,20">
        <TextBlock DockPanel.Dock="Top" Text="Friends" FontSize="20" FontWeight="SemiBold"/>

        <!-- Search every member who has used the manager, online or not. -->
        <Border DockPanel.Dock="Top" Margin="0,14,0,0" Background="{StaticResource Panel2Brush}"
                BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="6" Padding="8,0" Height="34">
            <Grid>
                <TextBlock x:Name="SearchHint" Text="Find members by name" Foreground="{StaticResource MutedBrush}"
                           VerticalAlignment="Center" IsHitTestVisible="False" Margin="2,0,0,0"/>
                <TextBox x:Name="SearchBox" Background="Transparent" BorderThickness="0" VerticalContentAlignment="Center"
                         Foreground="{StaticResource TextBrush}" CaretBrush="{StaticResource TextBrush}" MaxLength="24"
                         TextChanged="SearchBox_TextChanged"/>
            </Grid>
        </Border>
        <StackPanel x:Name="SearchResults" DockPanel.Dock="Top" Margin="0,8,0,0" Visibility="Collapsed"/>

        <TextBlock x:Name="StateText" DockPanel.Dock="Top" Foreground="{StaticResource MutedBrush}" Margin="0,12,0,0"
                   TextWrapping="Wrap" Visibility="Collapsed"/>

        <Button DockPanel.Dock="Bottom" Content="Close" Style="{StaticResource Btn}" MinWidth="90" HorizontalAlignment="Right"
                Margin="0,14,0,0" IsCancel="True" Click="Close_Click"/>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
            <StackPanel x:Name="Lists"/>
        </ScrollViewer>
    </DockPanel>
</Window>
