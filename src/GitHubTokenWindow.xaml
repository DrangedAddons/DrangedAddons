<Window x:Class="DrangedAddons.GitHubTokenWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GitHub token" Width="600" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI" FontSize="13">
    <StackPanel Margin="24,20">
        <TextBlock Text="GitHub token" FontSize="20" FontWeight="SemiBold"/>
        <TextBlock Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,6,0,0"
                   Text="DrangedAddons checks GitHub for updates. Without signing in, GitHub allows 60 checks an hour, shared by everything on your internet connection. A free GitHub token raises that to 5,000 an hour (and lets the app check every minute)."/>

        <!-- Current status -->
        <Border Margin="0,16,0,0" Padding="12,10" CornerRadius="6"
                Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
            <StackPanel>
                <TextBlock x:Name="SourceText" FontWeight="SemiBold" Text="Checking…"/>
                <TextBlock x:Name="AllowanceText" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0"/>
            </StackPanel>
        </Border>

        <!-- How to get one -->
        <TextBlock Text="Get a free token" FontWeight="SemiBold" FontSize="15" Margin="0,20,0,6"/>
        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" LineHeight="20"><Run Text="1.  Click "/><Run Text="Open GitHub" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/><Run Text=" and sign in (any free GitHub account works)."/><LineBreak/><Run Text="2.  Token name: "/><Run Text="DrangedAddons" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/><Run Text=". Pick an expiration (up to a year, or none)."/><LineBreak/><Run Text="3.  Repository access: "/><Run Text="Public repositories" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/><Run Text=". Don't add any permissions; none are needed."/><LineBreak/><Run Text="4.  Click "/><Run Text="Generate token" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/><Run Text=", copy it, and paste it below."/></TextBlock>
        <Button Content="Open GitHub" Style="{StaticResource Btn}" HorizontalAlignment="Left" Margin="0,10,0,0"
                Click="OpenGitHub_Click"/>

        <!-- Paste -->
        <TextBlock Text="Paste your token" FontWeight="SemiBold" Margin="0,18,0,6"/>
        <Border Background="{StaticResource Panel2Brush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                CornerRadius="6" Padding="8,0" Height="32">
            <PasswordBox x:Name="TokenBox" Background="Transparent" BorderThickness="0" VerticalContentAlignment="Center"
                         Foreground="{StaticResource TextBrush}" CaretBrush="{StaticResource TextBrush}"
                         PasswordChanged="TokenBox_PasswordChanged"/>
        </Border>
        <TextBlock x:Name="MessageText" TextWrapping="Wrap" Margin="0,8,0,0" Visibility="Collapsed"/>
        <TextBlock Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,0" FontSize="12"
                   Text="It's stored encrypted by Windows, readable only by your Windows account on this PC, and only ever sent to GitHub."/>

        <DockPanel Margin="0,20,0,0">
            <Button x:Name="RemoveButton" Content="Remove saved token" Style="{StaticResource GhostBtn}"
                    DockPanel.Dock="Left" Click="Remove_Click" Visibility="Collapsed"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Close" Style="{StaticResource Btn}" MinWidth="90" IsCancel="True" Margin="0,0,8,0"
                        Click="Close_Click"/>
                <Button x:Name="SaveButton" Content="Save token" Style="{StaticResource AccentBtn}" MinWidth="110"
                        IsDefault="True" IsEnabled="False" Click="Save_Click"/>
            </StackPanel>
        </DockPanel>
    </StackPanel>
</Window>
