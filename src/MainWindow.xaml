<Window x:Class="DrangedAddons.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DrangedAddons" Width="960" Height="640" MinWidth="720" MinHeight="440"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI" FontSize="13">
    <DockPanel>
    <Menu DockPanel.Dock="Top" Style="{StaticResource DarkMenu}">
        <MenuItem Header="_File">
            <MenuItem x:Name="OpenFolderMenu" Header="Open AddOns folder" Click="OpenFolder_Click"/>
            <MenuItem x:Name="ChangeFolderMenu" Header="Change WoW folder…" Click="ChangeFolder_Click"/>
            <MenuItem x:Name="ScanGamesMenu" Header="Scan game folder" Click="ScanGames_Click"/>
            <MenuItem Header="GitHub token…" Click="GitHubToken_Click"/>
            <Separator Style="{StaticResource MenuSeparator}"/>
            <MenuItem x:Name="CloseToTrayMenu" Header="Keep running in the tray when closed" IsCheckable="True"
                      Click="CloseToTray_Click"/>
            <MenuItem x:Name="NotificationsMenu" Header="Show update notifications" IsCheckable="True"
                      Click="Notifications_Click"/>
            <Separator Style="{StaticResource MenuSeparator}"/>
            <MenuItem x:Name="BetaMenu" Header="Show beta versions" IsCheckable="True" Click="Beta_Click"
                      ToolTip="Also offer untagged versions from each addon's main branch, not just tagged releases."/>
            <MenuItem x:Name="AutoUpdateAddonsMenu" Header="Auto-update addons" IsCheckable="True"
                      Click="AutoUpdateAddons_Click"
                      ToolTip="Install addon updates automatically in every game version (not Git working copies or versions you picked in Versions…)."/>
            <MenuItem x:Name="AutoUpdateAppMenu" Header="Auto-update DrangedAddons" IsCheckable="True"
                      Click="AutoUpdateApp_Click"
                      ToolTip="Update the app itself automatically and restart it (back into the tray if that's where it was)."/>
            <Separator Style="{StaticResource MenuSeparator}"/>
            <MenuItem x:Name="UninstallAppMenu" Header="Uninstall DrangedAddons…" Click="UninstallApp_Click"/>
            <MenuItem Header="Exit" Click="Exit_Click"/>
        </MenuItem>
        <MenuItem Header="_Help">
            <MenuItem Header="Check for app updates" Click="CheckAppUpdates_Click"/>
            <MenuItem Header="DrangedAddons on GitHub" Click="OpenAppRepo_Click"/>
            <Separator Style="{StaticResource MenuSeparator}"/>
            <MenuItem Header="About DrangedAddons" Click="About_Click"/>
        </MenuItem>
    </Menu>
    <Grid Margin="20,16,20,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top bar: game logo, search, game version, ⋮ menu (folder actions). -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <!-- Logo for the selected game version (set in UpdateGameLogo): official art from logos\, or a drawn
                 wordmark for versions without one. PTR/Beta get a tag over the logo. -->
            <!-- Fixed size: the logo files share one canvas (tools/make_logos.py), so switching never shifts the bar. -->
            <Grid Margin="0,0,14,0" VerticalAlignment="Center" Width="132" Height="72">
            <Image x:Name="GameLogoImage" Width="126" Height="72" Stretch="Uniform" HorizontalAlignment="Center"
                   RenderOptions.BitmapScalingMode="HighQuality"/>
            <Border x:Name="GameLogoTag" HorizontalAlignment="Right" VerticalAlignment="Bottom" Padding="5,0" CornerRadius="3"
                    Background="{StaticResource AccentBrush}" Visibility="Collapsed" Panel.ZIndex="1">
                <TextBlock x:Name="GameLogoTagText" FontSize="10" FontWeight="Bold" Foreground="Black"/>
            </Border>
            <StackPanel x:Name="GameLogoText" VerticalAlignment="Center">
                <TextBlock Text="WORLD of" FontFamily="Georgia" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center"
                           Foreground="{Binding Foreground, ElementName=GameLogoTitle}"/>
                <TextBlock x:Name="GameLogoTitle" Text="WARCRAFT" FontFamily="Georgia" FontSize="20" FontWeight="Bold"
                           HorizontalAlignment="Center" Margin="0,-3,0,0" Foreground="#F2B33D">
                    <TextBlock.Effect>
                        <DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.8" Color="Black"/>
                    </TextBlock.Effect>
                </TextBlock>
                <Border x:Name="GameLogoEditionBox" HorizontalAlignment="Center" Margin="0,2,0,0" Padding="7,1" CornerRadius="3"
                        Background="#3A2C10" BorderBrush="#F2B33D" BorderThickness="1">
                    <TextBlock x:Name="GameLogoEdition" Text="CLASSIC" FontFamily="Georgia" FontSize="9" FontWeight="Bold"
                               Foreground="#F2B33D"/>
                </Border>
            </StackPanel>
            </Grid>
            <TextBox x:Name="SearchBox" Grid.Column="1" VerticalAlignment="Center" Height="38" FontSize="14"
                     Style="{StaticResource SearchBox}" Tag="Search addons…  (Ctrl+F)"
                     TextChanged="Search_TextChanged"/>
            <ComboBox x:Name="FlavorList" Grid.Column="2" Style="{StaticResource DarkCombo}" Width="210" Height="38"
                      Margin="12,0,0,0" VerticalAlignment="Center" FontSize="14" ToolTip="Game version"
                      SelectionChanged="Flavor_SelectionChanged">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Label}"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <Button x:Name="GameMenuButton" Grid.Column="3" Style="{StaticResource GhostBtn}" Width="38" Height="38"
                    Margin="6,0,0,0" Padding="0" VerticalAlignment="Center" Click="GameMenu_Click" ToolTip="Game folder options">
                <TextBlock Text="&#xE712;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16"/>
                <Button.ContextMenu>
                    <ContextMenu>
                        <!-- The folder paths are in these items' tooltips (set in UpdateFolderTooltips). -->
                        <MenuItem x:Name="ScanGamesItem" Click="ScanGames_Click" ToolTipService.ShowOnDisabled="True">
                            <MenuItem.Header>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Width="26" VerticalAlignment="Center"/>
                                    <TextBlock Text="Scan game folder"/>
                                </StackPanel>
                            </MenuItem.Header>
                        </MenuItem>
                        <MenuItem x:Name="OpenFolderItem" Click="OpenFolder_Click" ToolTipService.ShowOnDisabled="True">
                            <MenuItem.Header>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE838;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Width="26" VerticalAlignment="Center"/>
                                    <TextBlock Text="Open AddOns folder"/>
                                </StackPanel>
                            </MenuItem.Header>
                        </MenuItem>
                        <Separator Style="{StaticResource MenuSeparator}"/>
                        <MenuItem x:Name="ChangeFolderItem" Click="ChangeFolder_Click" ToolTipService.ShowOnDisabled="True">
                            <MenuItem.Header>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8B7;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Width="26" VerticalAlignment="Center"/>
                                    <TextBlock Text="Change WoW folder…"/>
                                </StackPanel>
                            </MenuItem.Header>
                        </MenuItem>
                    </ContextMenu>
                </Button.ContextMenu>
            </Button>
        </Grid>

        <StackPanel Grid.Row="1" Margin="0,14,0,0">
        <!-- Shown when a newer DrangedAddons release exists. -->
        <Border x:Name="UpdateBanner" Visibility="Collapsed" Margin="0,0,0,12" Padding="12,8" CornerRadius="8"
                Background="#2A2410" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1">
            <DockPanel>
                <StackPanel x:Name="UpdateBannerButtons" DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="WhatsNewButton" Content="What's new" Style="{StaticResource GhostBtn}" Click="WhatsNew_Click"/>
                    <Button x:Name="SelfUpdateButton" Content="Restart to update" Style="{StaticResource ProgressAccentBtn}" Width="170"
                            Click="SelfUpdate_Click" Margin="8,0,0,0"/>
                    <Button x:Name="TokenButton" Content="Add GitHub token" Style="{StaticResource DangerBtn}"
                            Click="GitHubToken_Click" Margin="8,0,0,0"/>
                </StackPanel>
                <TextBlock x:Name="UpdateBannerText" VerticalAlignment="Center" FontWeight="SemiBold" TextWrapping="Wrap"
                           Margin="0,0,12,0"/>
            </DockPanel>
        </Border>
        </StackPanel>

        <Grid Grid.Row="2">
            <DockPanel x:Name="ListPanel">
            <!-- Tabs (installed / everything) and search. -->
            <!-- The selected tab's gold underline sits on a full-width rule. -->
            <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                <Border Height="1" VerticalAlignment="Bottom" Background="{StaticResource LineBrush}"/>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                    <RadioButton x:Name="MyAddonsTab" GroupName="AddonTabs" Style="{StaticResource TabButton}"
                                 Content="My Addons" IsChecked="True" Checked="Tab_Checked"/>
                    <RadioButton x:Name="BrowseTab" GroupName="AddonTabs" Style="{StaticResource TabButton}"
                                 Content="Browse" Checked="Tab_Checked"/>
                </StackPanel>
            </Grid>
            <!-- Toolbar: Update all; list tools (filter, refresh) on the right. -->
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="FilterButton" Style="{StaticResource IconBtn}" Content="&#xE71C;" Click="Filter_Click"
                            ToolTip="Filter">
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem x:Name="FilterAll" Header="All addons" IsCheckable="True" IsChecked="True" Click="FilterItem_Click"/>
                                <Separator Style="{StaticResource MenuSeparator}"/>
                                <MenuItem Header="Updates available" Tag="updates" IsCheckable="True" Click="FilterItem_Click"/>
                                <MenuItem Header="Up to date" Tag="uptodate" IsCheckable="True" Click="FilterItem_Click"/>
                                <MenuItem Header="Not installed" Tag="notinstalled" IsCheckable="True" Click="FilterItem_Click"/>
                                <MenuItem Header="Beta versions" Tag="beta" IsCheckable="True" Click="FilterItem_Click"/>
                                <MenuItem Header="Git working copies" Tag="git" IsCheckable="True" Click="FilterItem_Click"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                    <Button x:Name="ColumnsButton" Style="{StaticResource IconBtn}" Margin="4,0,0,0" Click="Columns_Click"
                            ToolTip="Edit columns">
                        <!-- Three-column glyph, drawn in the button's text colour. -->
                        <Path Data="M 0.5 0.5 H 15.5 V 13.5 H 0.5 Z M 5.5 0.5 V 13.5 M 10.5 0.5 V 13.5" StrokeThickness="1.2"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                    </Button>
                    <Button x:Name="RefreshButton" Style="{StaticResource IconBtn}" Content="&#xE72C;" Margin="4,0,0,0"
                            Click="Refresh_Click" ToolTip="Check for updates"/>
                </StackPanel>
                <Button x:Name="UpdateAllButton" Content="Update all" Style="{StaticResource AccentBtn}" HorizontalAlignment="Left"
                        Click="UpdateAll_Click" IsEnabled="False"/>
            </DockPanel>
            <!-- Column header: select-all for the rows shown (this tab + search + filter). -->
            <!-- Same padding + border as a row, so the select-all box lines up with the row tickboxes. -->
            <Border x:Name="ListHeader" DockPanel.Dock="Top" Margin="0,0,0,4" Padding="10,7" CornerRadius="6"
                    Background="{StaticResource Panel2Brush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
                <DockPanel>
                    <CheckBox x:Name="SelectAllCheck" DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,10,0"
                              Click="SelectAll_Click" ToolTip="Select all addons shown"/>
                    <!-- Widths match the row template's optional columns and Action column (1px rule + text). -->
                    <TextBlock DockPanel.Dock="Right" Text="Action" Foreground="{StaticResource MutedBrush}" FontSize="12"
                               FontWeight="SemiBold" Width="140" Margin="9,0,0,0" TextAlignment="Center" VerticalAlignment="Center"/>
                    <Border DockPanel.Dock="Right" Width="1" Margin="0,-7" Background="{StaticResource LineBrush}"/>
                    <!-- In column edit mode, drag a header left / right to reorder (see HeaderCell_MouseDown). A ghost of
                         the header follows the cursor; the columns themselves move live to preview the new order. -->
                    <Grid DockPanel.Dock="Right">
                    <ItemsControl x:Name="HeaderColumns" Focusable="False" VerticalAlignment="Stretch"
                                  ItemsSource="{Binding Columns, RelativeSource={RelativeSource AncestorType=Window}}"
                                  MouseMove="HeaderColumns_MouseMove" MouseLeftButtonUp="HeaderColumns_MouseUp"
                                  LostMouseCapture="HeaderColumns_LostMouseCapture">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Width="{Binding Width}" MouseLeftButtonDown="HeaderCell_MouseDown">
                                    <DockPanel.Style>
                                        <Style TargetType="DockPanel">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ColumnEditMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                    <Setter Property="Cursor" Value="SizeWE"/>
                                                    <Setter Property="ToolTip" Value="Drag to move this column"/>
                                                </DataTrigger>
                                                <!-- The dragged column's slot: shows where it will land. -->
                                                <DataTrigger Binding="{Binding IsDragging}" Value="True">
                                                    <Setter Property="Background" Value="#2A2410"/>
                                                    <Setter Property="ToolTip" Value="{x:Null}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DockPanel.Style>
                                    <Border DockPanel.Dock="Left" Width="1" Margin="0,-7" Background="{StaticResource LineBrush}"/>
                                    <!-- Column edit mode: hide. -->
                                    <Button DockPanel.Dock="Right" Style="{StaticResource ColumnEditBtn}" Content="&#xE711;" Margin="0,0,4,0"
                                            ToolTip="Hide column" Click="ColumnHide_Click" Cursor="Hand"
                                            Visibility="{Binding ColumnEditMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}"/>
                                    <TextBlock Text="{Binding Header}" Foreground="{StaticResource MutedBrush}" FontSize="12"
                                               FontWeight="SemiBold" Padding="11,0,0,0" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" Style="{StaticResource DraggedColumnDim}"/>
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Canvas IsHitTestVisible="False">
                        <Border x:Name="DragGhost" Visibility="Collapsed" Canvas.Top="-7" CornerRadius="4" Opacity="0.95"
                                Background="#3A3216" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.6" Color="Black"/>
                            </Border.Effect>
                            <TextBlock x:Name="DragGhostText" Foreground="{StaticResource TextBrush}" FontSize="12"
                                       FontWeight="SemiBold" Padding="11,0,0,0" VerticalAlignment="Center"/>
                        </Border>
                    </Canvas>
                    </Grid>
                    <TextBlock Text="Name" Foreground="{StaticResource MutedBrush}" FontSize="12" FontWeight="SemiBold"
                               Margin="44,0,0,0" VerticalAlignment="Center"/>
                </DockPanel>
            </Border>
            <!-- Column edit mode: hidden columns to add back, reset, done. -->
            <Border x:Name="ColumnEditBar" DockPanel.Dock="Top" Margin="0,0,0,6" Padding="10,6" CornerRadius="6"
                    Background="#2A2410" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1"
                    Visibility="{Binding ColumnEditMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Content="Reset" Style="{StaticResource GhostBtn}" Padding="12,4" Click="ColumnReset_Click"
                                ToolTip="Back to the default columns (Installed, Latest, Author)"/>
                        <Button Content="Done" Style="{StaticResource AccentBtn}" Padding="16,4" Margin="8,0,0,0" Click="ColumnDone_Click"/>
                    </StackPanel>
                    <TextBlock DockPanel.Dock="Left" Text="Editing columns" FontWeight="SemiBold" VerticalAlignment="Center"
                               Margin="0,0,14,0"/>
                    <TextBlock x:Name="NoHiddenColumnsText" DockPanel.Dock="Left" Text="Drag a column header to move it, ✕ to hide it."
                               Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,14,0"/>
                    <ItemsControl Focusable="False" VerticalAlignment="Center"
                                  ItemsSource="{Binding HiddenColumns, RelativeSource={RelativeSource AncestorType=Window}}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource GhostBtn}" Padding="10,3" Margin="0,0,6,0" Click="ColumnShow_Click"
                                        ToolTip="Show this column">
                                    <TextBlock>
                                        <Run Text="+" Foreground="{StaticResource AccentBrush}" FontWeight="Bold"/>
                                        <Run Text="{Binding Header, Mode=OneWay}"/>
                                    </TextBlock>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DockPanel>
            </Border>
            <Grid>
            <!-- Addon list: one compact row per addon; click a row for its details. -->
            <ScrollViewer x:Name="ListScroll" VerticalScrollBarVisibility="Auto" ScrollChanged="ListScroll_ScrollChanged">
                <ItemsControl x:Name="AddonList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource AddonRow}" MouseLeftButtonUp="Row_Click">
                                <Border.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Open details" FontWeight="SemiBold" Click="RowDetails_Click"/>
                                        <MenuItem Header="Reinstall" Click="RowReinstall_Click" IsEnabled="{Binding CanUninstall}"/>
                                        <MenuItem Header="Browse folder" Click="RowBrowse_Click" IsEnabled="{Binding CanBrowse}"/>
                                        <MenuItem Header="View changelog" Click="RowChangelog_Click"/>
                                        <Separator Style="{StaticResource MenuSeparator}"/>
                                        <MenuItem Header="Delete addon" Foreground="{StaticResource DangerBrush}"
                                                  Click="RowDelete_Click" IsEnabled="{Binding CanUninstall}"/>
                                    </ContextMenu>
                                </Border.ContextMenu>
                                <DockPanel>
                                    <!-- Tick for bulk actions (clicking it doesn't open the details page). -->
                                    <CheckBox DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,10,0" Cursor="Hand"
                                              IsChecked="{Binding IsSelected, Mode=TwoWay}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <!-- Optional columns (each a fixed width) and Action, lined up with the header. -->
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="150"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid Width="32" Height="32" Margin="0,0,12,0" VerticalAlignment="Center">
                                        <Border CornerRadius="6" Background="{StaticResource Panel2Brush}"
                                                BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                                                Visibility="{Binding NoIcon, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="{Binding Initial}" FontSize="15" FontWeight="SemiBold"
                                                       Foreground="{StaticResource AccentBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <Image Source="{Binding Icon}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"
                                               Visibility="{Binding HasIcon, Converter={StaticResource BoolToVis}}"/>
                                    </Grid>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                            <Border Style="{StaticResource BetaBubble}">
                                                <TextBlock Text="BETA" Foreground="White" FontSize="9.5" FontWeight="Bold"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding RowSubText}" Foreground="{StaticResource MutedBrush}" FontSize="12"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <ItemsControl Grid.Column="2" Focusable="False" VerticalAlignment="Center"
                                                  ItemsSource="{Binding Columns, RelativeSource={RelativeSource AncestorType=Window}}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Width="{Binding Width}" FontSize="12" Padding="12,0,8,0"
                                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                           Style="{StaticResource DraggedColumnDim}">
                                                    <TextBlock.Text>
                                                        <MultiBinding Converter="{StaticResource CellText}">
                                                            <Binding Path="Key"/>
                                                            <Binding Path="DataContext" RelativeSource="{RelativeSource AncestorType=ItemsControl}"/>
                                                            <Binding Path="DataContext.RowVersionText" RelativeSource="{RelativeSource AncestorType=ItemsControl}"/>
                                                        </MultiBinding>
                                                    </TextBlock.Text>
                                                </TextBlock>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <!-- One thing on the right: a button when there's something to do, else a label. -->
                                    <TextBlock Grid.Column="3" Text="{Binding RowLabel}" Foreground="{Binding RowLabelBrush}"
                                               FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Center"
                                               Margin="10,0,0,0"
                                               Visibility="{Binding ShowRowLabel, Converter={StaticResource BoolToVis}}"/>
                                    <Button Grid.Column="3" Content="{Binding ActionText}" Style="{StaticResource ActionBtn}"
                                            Padding="0,3" Width="140" Margin="10,0,0,0" VerticalAlignment="Center"
                                            IsEnabled="{Binding ActionEnabled}" Click="Action_Click"
                                            Visibility="{Binding ShowRowAction, Converter={StaticResource BoolToVis}}"/>
                                </Grid>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <TextBlock x:Name="EmptyText" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                       TextWrapping="Wrap" MaxWidth="460" Foreground="{StaticResource MutedBrush}" Visibility="Collapsed"/>
            </Grid>
            </DockPanel>

            <!-- Details page for one addon (DataContext = its AddonRow). The tab pages are filled in MainWindow.Details.cs. -->
            <Grid x:Name="DetailsPanel" Visibility="Collapsed">
            <DockPanel>
                <Button DockPanel.Dock="Top" Style="{StaticResource GhostBtn}" HorizontalAlignment="Left" Padding="10,5"
                        Margin="0,0,0,12" Click="Back_Click" ToolTip="Back to the addon list (Esc)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72B;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13"
                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="Addons" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- The whole page scrolls together: header, tabs, then the open tab. -->
                <ScrollViewer x:Name="DetailsScroll" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,10,10">
                <!-- Header: icon, name, status, actions; stats underneath. -->
                <Border Padding="16,14" CornerRadius="8"
                        Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid Width="72" Height="72" Margin="0,0,16,0" VerticalAlignment="Top">
                            <Border CornerRadius="10" Background="{StaticResource Panel2Brush}"
                                    BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                                    Visibility="{Binding NoIcon, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding Initial}" FontSize="30" FontWeight="SemiBold"
                                           Foreground="{StaticResource AccentBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <Image Source="{Binding Icon}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"
                                   Visibility="{Binding HasIcon, Converter={StaticResource BoolToVis}}"/>
                        </Grid>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Name}" FontSize="22" FontWeight="SemiBold"/>
                                <Border Background="{Binding StatusBrush}" CornerRadius="9" Padding="8,1"
                                        Margin="12,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding StatusText}" Foreground="#111111" FontSize="11" FontWeight="SemiBold"/>
                                </Border>
                                <Border Style="{StaticResource BetaBubble}">
                                    <TextBlock Text="BETA" Foreground="White" FontSize="10.5" FontWeight="Bold"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="{Binding AuthorText}" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0"/>
                            <TextBlock Text="{Binding VersionText}" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                            <Button Content="{Binding ActionText}" Style="{StaticResource ActionBtn}" Width="150" Padding="0,5"
                                    IsEnabled="{Binding ActionEnabled}" Click="Action_Click"
                                    Visibility="{Binding ShowRowAction, Converter={StaticResource BoolToVis}}"/>
                            <TextBlock Text="{Binding RowLabel}" Foreground="{Binding RowLabelBrush}" FontWeight="SemiBold"
                                       VerticalAlignment="Center" Margin="0,0,6,0"
                                       Visibility="{Binding ShowRowLabel, Converter={StaticResource BoolToVis}}"/>
                            <Button x:Name="DetailsMenuButton" Style="{StaticResource IconBtn}" Content="&#xE712;" Margin="8,0,0,0"
                                    Click="DetailsMenu_Click" ToolTip="More">
                                <Button.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Reinstall" Click="RowReinstall_Click" IsEnabled="{Binding CanUninstall}"/>
                                        <MenuItem Header="Browse folder" Click="RowBrowse_Click" IsEnabled="{Binding CanBrowse}"/>
                                        <MenuItem Header="View on GitHub" Click="ViewOnGitHub_Click"/>
                                        <Separator Style="{StaticResource MenuSeparator}"/>
                                        <MenuItem Header="Delete addon" Foreground="{StaticResource DangerBrush}"
                                                  Click="RowDelete_Click" IsEnabled="{Binding CanUninstall}"/>
                                    </ContextMenu>
                                </Button.ContextMenu>
                            </Button>
                        </StackPanel>
                        <!-- Stats: downloads, last update, size on disk, game versions (set in UpdateDetailStats). -->
                        <Border Grid.Row="1" Grid.ColumnSpan="3" Margin="0,12,0,0" Padding="0,10,0,0"
                                BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0">
                            <WrapPanel>
                                <WrapPanel.Resources>
                                    <Style x:Key="StatIcon" TargetType="TextBlock">
                                        <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
                                        <Setter Property="FontSize" Value="13"/>
                                        <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Margin" Value="0,0,6,0"/>
                                    </Style>
                                    <Style x:Key="StatText" TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Margin" Value="0,0,22,0"/>
                                    </Style>
                                </WrapPanel.Resources>
                                <StackPanel Orientation="Horizontal" ToolTip="Downloads of this addon's release files on GitHub">
                                    <TextBlock Style="{StaticResource StatIcon}" Text="&#xE896;"/>
                                    <TextBlock x:Name="DownloadsText" Style="{StaticResource StatText}" Text="…"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" ToolTip="When the latest version came out">
                                    <TextBlock Style="{StaticResource StatIcon}" Text="&#xE823;"/>
                                    <TextBlock x:Name="UpdatedText" Style="{StaticResource StatText}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" ToolTip="Space used in this game's AddOns folder">
                                    <TextBlock Style="{StaticResource StatIcon}" Text="&#xE8B7;"/>
                                    <TextBlock x:Name="SizeText" Style="{StaticResource StatText}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" ToolTip="Game versions this addon is made for">
                                    <TextBlock Style="{StaticResource StatIcon}" Text="&#xE7FC;"/>
                                    <TextBlock x:Name="GamesText" Style="{StaticResource StatText}"/>
                                </StackPanel>
                            </WrapPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- Tabs. -->
                <Grid Margin="0,14,0,12">
                    <Border Height="1" VerticalAlignment="Bottom" Background="{StaticResource LineBrush}"/>
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="OverviewTab" GroupName="DetailTabs" Style="{StaticResource TabButton}" Content="Overview"
                                     IsChecked="True" Checked="DetailTab_Checked"/>
                        <RadioButton x:Name="ChangelogTab" GroupName="DetailTabs" Style="{StaticResource TabButton}" Content="Changelog"
                                     Checked="DetailTab_Checked"/>
                        <RadioButton x:Name="GalleryTab" GroupName="DetailTabs" Style="{StaticResource TabButton}" Content="Gallery"
                                     Checked="DetailTab_Checked"/>
                        <RadioButton x:Name="VersionsTab" GroupName="DetailTabs" Style="{StaticResource TabButton}" Content="Versions"
                                     Checked="DetailTab_Checked"/>
                    </StackPanel>
                </Grid>

                <Grid MinHeight="160">
                    <Border x:Name="OverviewPage">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="260"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel x:Name="OverviewContent" Margin="0,0,20,0"/>
                            <Border Grid.Column="1" VerticalAlignment="Top" Padding="14,12" CornerRadius="8"
                                    Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="About" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8"/>
                                    <StackPanel x:Name="AboutPanel"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                    <Border x:Name="ChangelogPage" Visibility="Collapsed">
                        <StackPanel x:Name="ChangelogContent" MaxWidth="920" HorizontalAlignment="Left"/>
                    </Border>
                    <Border x:Name="GalleryPage" Visibility="Collapsed">
                        <WrapPanel x:Name="GalleryContent"/>
                    </Border>
                    <DockPanel x:Name="VersionsPage" Visibility="Collapsed">
                        <TextBlock x:Name="VersionsNote" DockPanel.Dock="Top" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                                   Margin="0,0,0,10"/>
                        <!-- Long histories are shown 20 at a time. -->
                        <StackPanel DockPanel.Dock="Bottom" HorizontalAlignment="Center" Margin="0,6,0,0">
                            <Button x:Name="MoreVersionsButton" Style="{StaticResource GhostBtn}" Padding="18,6" Click="MoreVersions_Click"
                                    Visibility="Collapsed"/>
                            <TextBlock x:Name="VersionsCountText" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center"
                                       Margin="0,6,0,0"/>
                        </StackPanel>
                            <ItemsControl x:Name="VersionList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource AddonRow}" MouseLeftButtonUp="VersionRow_Click"
                                                ToolTip="Click to show or hide what changed">
                                            <StackPanel>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding Version.Version}" FontSize="15" FontWeight="SemiBold"/>
                                                            <Border Background="{Binding KindBrush}" CornerRadius="9" Padding="8,1" Margin="10,0,0,0" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding KindText}" Foreground="#111111" FontSize="11" FontWeight="SemiBold"/>
                                                            </Border>
                                                            <Border Background="{StaticResource AccentBrush}" CornerRadius="9" Padding="8,1" Margin="6,0,0,0"
                                                                    VerticalAlignment="Center"
                                                                    Visibility="{Binding IsInstalled, Converter={StaticResource BoolToVis}}">
                                                                <TextBlock Text="Installed" Foreground="#111111" FontSize="11" FontWeight="SemiBold"/>
                                                            </Border>
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding DateText}" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0"/>
                                                    </StackPanel>
                                                    <Button Grid.Column="1" Content="{Binding ActionText}" Style="{StaticResource Btn}" MinWidth="100"
                                                            VerticalAlignment="Center" Click="VersionInstall_Click"
                                                            Visibility="{Binding CanInstall, Converter={StaticResource BoolToVis}}"/>
                                                </Grid>
                                                <ContentControl Content="{Binding NotesView}" Margin="0,10,0,0" Focusable="False"
                                                                Visibility="{Binding ShowNotes, Converter={StaticResource BoolToVis}}"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                    </DockPanel>
                    <TextBlock x:Name="DetailsMessage" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                               TextWrapping="Wrap" MaxWidth="460" Foreground="{StaticResource MutedBrush}" Visibility="Collapsed"/>
                </Grid>
                </StackPanel>
                </ScrollViewer>
            </DockPanel>

            <!-- Gallery viewer: one image large; arrows / ← → to move, Esc or click outside to close. -->
            <Grid x:Name="Lightbox" Visibility="Collapsed" Background="#EE0E1013" MouseLeftButtonUp="Lightbox_BackdropClick">
                <Image x:Name="LightboxImage" Margin="70,40,70,50" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"
                       MouseLeftButtonUp="LightboxImage_Click"/>
                <Button Style="{StaticResource IconBtn}" Content="&#xE76B;" Width="44" Height="44" FontSize="20"
                        HorizontalAlignment="Left" Margin="12,0,0,0" Click="LightboxPrev_Click" ToolTip="Previous (←)"/>
                <Button Style="{StaticResource IconBtn}" Content="&#xE76C;" Width="44" Height="44" FontSize="20"
                        HorizontalAlignment="Right" Margin="0,0,12,0" Click="LightboxNext_Click" ToolTip="Next (→)"/>
                <Button Style="{StaticResource IconBtn}" Content="&#xE711;" Width="36" Height="36" FontSize="14"
                        HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,12,0" Click="LightboxClose_Click" ToolTip="Close (Esc)"/>
                <TextBlock x:Name="LightboxCounter" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,14"
                           Foreground="{StaticResource MutedBrush}"/>
            </Grid>
            </Grid>

            <!-- Bulk actions for the ticked addons; slides up from the bottom when anything is selected. -->
            <Border x:Name="BulkBar" Visibility="Collapsed" VerticalAlignment="Bottom" HorizontalAlignment="Center"
                    Margin="0,0,0,12" Padding="10,8" CornerRadius="8"
                    Background="{StaticResource Panel2Brush}" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="3" Opacity="0.6" Color="Black"/>
                </Border.Effect>
                <Border.RenderTransform>
                    <TranslateTransform x:Name="BulkBarShift"/>
                </Border.RenderTransform>
                <StackPanel Orientation="Horizontal">
                    <Border CornerRadius="9" Background="{StaticResource AccentBrush}" Padding="8,1" VerticalAlignment="Center">
                        <TextBlock x:Name="BulkCountText" Foreground="{StaticResource AccentTextBrush}" FontWeight="SemiBold"/>
                    </Border>
                    <TextBlock Text="selected" VerticalAlignment="Center" Margin="8,0,16,0"/>
                    <Button x:Name="BulkUpdateButton" Style="{StaticResource GhostBtn}" Click="BulkUpdate_Click" Margin="0,0,6,0"/>
                    <Button x:Name="BulkInstallButton" Style="{StaticResource GhostBtn}" Click="BulkInstall_Click" Margin="0,0,6,0"/>
                    <Button x:Name="BulkReinstallButton" Style="{StaticResource GhostBtn}" Click="BulkReinstall_Click" Margin="0,0,6,0"/>
                    <Button x:Name="BulkDeleteButton" Style="{StaticResource GhostBtn}" Click="BulkDelete_Click"
                            Foreground="{StaticResource DangerBrush}"/>
                    <Button Content="✕" Style="{StaticResource GhostBtn}" Click="BulkClear_Click" Margin="14,0,0,0"
                            ToolTip="Clear the selection (Esc)"/>
                </StackPanel>
            </Border>
        </Grid>

        <DockPanel Grid.Row="3" Margin="0,8,0,0">
            <TextBlock x:Name="VersionText" DockPanel.Dock="Right" Foreground="{StaticResource MutedBrush}"
                       ToolTip="Help → Check for app updates"/>
            <!-- How much of this hour's GitHub allowance has been used; click for the GitHub token window. -->
            <StackPanel x:Name="UsagePanel" DockPanel.Dock="Right" Orientation="Horizontal" Margin="0,0,18,0"
                        Background="Transparent" Cursor="Hand" Visibility="Collapsed"
                        MouseLeftButtonUp="Usage_Click">
                <TextBlock Text="GitHub" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <Grid Width="90" Height="6" VerticalAlignment="Center">
                    <Border CornerRadius="3" Background="{StaticResource Panel2Brush}"/>
                    <Border x:Name="UsageFill" CornerRadius="3" HorizontalAlignment="Left" Width="0"/>
                </Grid>
                <TextBlock x:Name="UsageText" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="8,0,0,0"/>
            </StackPanel>
            <TextBlock x:Name="StatusText" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis"/>
        </DockPanel>
    </Grid>
    </DockPanel>
</Window>
